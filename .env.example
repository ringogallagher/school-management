# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/school_management?sslmode=disable

# JWT Secret (Change this in production!)
JWT_SECRET=your-secret-key-change-in-production

# Server Configuration
PORT=8080

# Environment
ENVIRONMENT=development

# First administrator - created on startup when the database has no admin.
# Public self-registration is disabled, so this is how you get the first login.
ADMIN_EMAIL=admin@school.test
ADMIN_PASSWORD=admin12345

# Set to true when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Login attempts allowed per IP per minute
LOGIN_RATE_LIMIT=10

# Hour (0-23, server time) of the daily "attendance not marked" reminder; -1 disables it
REMINDER_HOUR=15

# E-mail copies of notifications. Without SMTP_HOST no mail is sent;
# EMAIL_LOG=true writes the e-mails to the log instead (handy for demos).
EMAIL_LOG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=School register <no-reply@school.test>
